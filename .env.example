# =============================================================================
# WorldPulse environment configuration
# Copy to .env.local for local development, or set these in your host's dashboard.
# Nothing here is required to try the game locally: with no variables set, WorldPulse
# runs on a local JSON file database with clearly labelled demo scenarios.
#
# NEVER commit real values. Variables without the NEXT_PUBLIC_ prefix stay on the server.
# =============================================================================

# -----------------------------------------------------------------------------
# Sessions (REQUIRED in production)
# Signs the httpOnly session cookie. Use 32+ random characters, e.g.:
#   openssl rand -base64 48
# In development a random secret is generated and stored in data/.secret.
# -----------------------------------------------------------------------------
AUTH_SECRET=

# Public URL of the deployed site, used in password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database and accounts: Supabase (REQUIRED for a real deployment)
# Without these, accounts and progress are stored in data/local-db.json. That is fine
# for local development but NOT for serverless hosting (the file system is temporary).
#
# Setup: create a Supabase project, run supabase/migrations/0001_worldpulse.sql in the
# SQL editor, enable Email auth, and set the Site URL / redirect URL to NEXT_PUBLIC_SITE_URL.
# Supabase Auth then sends confirmation and password-reset emails.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# News mode
#   auto  live news when an ingestion run has stored events, otherwise demo scenarios
#   demo  always show the fictional demo scenarios
#   live  only live news (an empty map until ingestion has run)
# -----------------------------------------------------------------------------
WP_NEWS_MODE=auto

# -----------------------------------------------------------------------------
# AI briefings and quizzes (REQUIRED for live news)
# Briefings and quizzes are generated from feed headlines and summaries by Claude.
# Without a key, ingestion still fetches and clusters stories but publishes none,
# because WorldPulse never shows a story without a checked briefing.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override. The default, claude-haiku-5-5, costs well under a cent per briefing.
# claude-sonnet-5-5 or claude-opus-5-5 write richer briefings at roughly 20x / 40x the cost.
WP_SUMMARY_MODEL=claude-haiku-5-5

# -----------------------------------------------------------------------------
# Scheduled refresh
# /api/cron/ingest requires "Authorization: Bearer $CRON_SECRET".
# On Vercel, vercel.json runs it hourly and sends this header automatically.
# Elsewhere, call it from any scheduler, or run `npm run ingest`.
# -----------------------------------------------------------------------------
CRON_SECRET=
WP_NEWS_REFRESH_MINUTES=60
WP_NEWS_MAX_EVENTS=40
WP_NEWS_MAX_AGE_HOURS=72
# Each run summarizes new stories for up to this many seconds, then leaves the rest for the next
# run (unchanged stories keep their briefing). Keeps runs inside Vercel's 300-second limit.
WP_INGEST_BUDGET_SECONDS=170
# Briefings generated in parallel.
WP_INGEST_CONCURRENCY=4
# A story that gains new reporting keeps its briefing until the briefing is this many hours old.
WP_NEWS_REWRITE_AFTER_HOURS=24

# -----------------------------------------------------------------------------
# News sources (only Bloomberg, BBC News, WSJ, Reuters, NPR and The New York Times)
# The default list uses each publisher's public RSS feeds. Check each publisher's feed
# terms before commercial use; some require a licence for display in a product.
#
# Reuters has no free public RSS feed. Add one only if you hold a licence
# (e.g. Reuters Connect), by setting its feed URL here.
REUTERS_FEED_URL=
# Replace the whole feed list (JSON array). Unknown publications are ignored.
#   WP_FEEDS=[{"publication":"BBC News","url":"https://feeds.bbci.co.uk/news/world/rss.xml","section":"World"}]
WP_FEEDS=
# Comma-separated publications to switch off, e.g. "Bloomberg,The Wall Street Journal".
WP_DISABLED_PUBLICATIONS=

# -----------------------------------------------------------------------------
# Game economy (optional; defaults shown). Rewards are always calculated on the server.
# -----------------------------------------------------------------------------
WP_COINS_PER_CORRECT=20
WP_XP_PER_CORRECT=10
WP_PERFECT_BONUS_COINS=25
WP_PERFECT_BONUS_XP=25
WP_SIGNUP_COINS=150
WP_STREAK_DAILY_COINS=10

# Importance weights (optional; must sum to 1). See docs/IMPORTANCE.md.
WP_W_COVERAGE=0.35
WP_W_PROMINENCE=0.20
WP_W_CONSEQUENCES=0.20
WP_W_RECENCY=0.15
WP_W_SIGNIFICANCE=0.10

# -----------------------------------------------------------------------------
# Local development only
# -----------------------------------------------------------------------------
# Where the local JSON database lives.
WP_LOCAL_DB_PATH=
# Password-reset links are shown on screen in development (there is no email service in
# local mode). Set to 0 to hide them. They are never shown in production.
WP_SHOW_DEV_RESET_LINKS=1
